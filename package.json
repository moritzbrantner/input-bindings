{
  "name": "input-bindings-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "node scripts/build-npm-packages.mjs",
    "pack:packages": "node scripts/pack-npm-packages.mjs",
    "test:ts": "npm run build:packages && node --experimental-strip-types --test packages/input-bindings/test/*.test.ts packages/input-bindings-runtime/test/*.test.ts packages/input-bindings-web/test/*.test.ts packages/input-bindings-react/test/*.test.ts",
    "build:pages": "npm run build:packages && npm run build --workspace @moritzbrantner/input-bindings-demo",
    "bench:ts": "node --experimental-strip-types packages/input-bindings/benchmark/run.ts",
    "bench:rust": "cargo run --locked --release -p input-bindings-core --example benchmark --",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --output-dir storybook-static",
    "test:storybook": "npm run build:storybook && npm run test:storybook:built",
    "test:storybook:built": "playwright test -c playwright.storybook.config.ts",
    "test:pages": "npm run build:pages && npm run test:pages:built",
    "test:pages:built": "playwright test -c playwright.pages.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.4.1",
    "@testing-library/dom": "10.4.2",
    "@types/react": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
