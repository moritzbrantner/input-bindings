{
  "name": "input-bindings-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:ts": "node --experimental-strip-types --test packages/input-bindings/test/*.test.ts packages/input-bindings-runtime/test/*.test.ts packages/input-bindings-web/test/*.test.ts packages/input-bindings-react/test/*.test.ts",
    "build:pages": "npm run build --workspace @moritzbrantner/input-bindings-demo",
    "bench:ts": "node --experimental-strip-types packages/input-bindings/benchmark/run.ts",
    "bench:rust": "cargo run --release -p input-bindings-core --example benchmark --"
  },
  "engines": {
    "node": ">=22.6"
  }
}
