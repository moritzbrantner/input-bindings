    "node_modules/@moritzbrantner/input-bindings-web": {
      "resolved": "packages/input-bindings-web",
      "link": true
    },
    "packages/input-bindings": {
      "name": "@moritzbrantner/input-bindings",
      "version": "0.1.0"
    },
    "packages/input-bindings-web": {
      "name": "@moritzbrantner/input-bindings-web",
      "version": "0.1.0",
      "dependencies": {
        "@moritzbrantner/input-bindings": "0.1.0"
      }
    }
  }
}
