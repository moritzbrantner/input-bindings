{
  "name": "input-bindings-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "input-bindings-workspace",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.6"
      }
    },
    "node_modules/@moritzbrantner/input-bindings": {
      "resolved": "packages/input-bindings",
