{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": true,
  "ignorePatterns": [
    "fixtures/**",
    "packages/*/test/fixtures/**",
    "bun.lock",
    "Cargo.lock",
    "target/**",
    "release/**",
    "packages/*/dist/**",
    "storybook-static/**",
    "test-results/**",
    ".unlighthouse/**",
    "**/node_modules/**"
  ]
}
