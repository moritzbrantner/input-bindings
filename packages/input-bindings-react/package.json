{
  "name": "@moritzbrantner/input-bindings-react",
  "version": "0.1.0",
  "description": "React keybinding editor, recorder, keyboard overview, and platform advisory UI",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src"],
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./platform-advisories.css": "./src/platform-advisories.css",
    "./model": {
      "types": "./src/model.ts",
      "import": "./dist/model.js"
    },
    "./platform-advisories": {
      "types": "./src/PlatformAwareKeybindingEditor.tsx",
      "import": "./dist/platform-advisories.js"
    }
  },
  "types": "./src/index.tsx",
  "dependencies": {
    "@moritzbrantner/input-bindings": "0.1.0",
    "@moritzbrantner/input-bindings-web": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moritzbrantner/input-bindings.git",
    "directory": "packages/input-bindings-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6"
  }
}
